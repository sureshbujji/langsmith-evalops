# Copy to .env for local development. Everything runs WITHOUT these set.
# The pipeline is offline-first: no key = local SQLite EvalStore.

# Set this (real key) to point the adapter at live LangSmith.
# Same function signatures, zero code changes -- see src/adapter.py.
LANGSMITH_API_KEY=

# Optional LangSmith overrides (only used when LANGSMITH_API_KEY is set).
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=langsmith-evalops

# Optional: SQLite file for the offline EvalStore (default: ./evalstore.db).
EVALOPS_DB=evalstore.db
